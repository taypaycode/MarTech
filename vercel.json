{
  "version": 2,
  "git": {
    "deploymentEnabled": {
      "vercel-build": true,
      "main": false
    }
  },
  "buildCommand": "cd frontend && CI=false npm install && CI=false npm run build",
  "outputDirectory": "frontend/build",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "REACT_APP_API_URL": "/api"
  }
}
